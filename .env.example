# Copy this file to .env and fill in a key ONLY if you want the AI layer on.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit a real key: a key pushed to a public repo
# is scraped and abused within minutes, and the bill is yours.
#
# Attest runs completely without any of this. The default reasoning engine is
# deterministic, needs no key, no account and no network, and produces every
# metric on its own. The AI layer only enriches explanations.

# Which reasoning engine to use: rules | gemini | openai | anthropic | ollama
ATTEST_ENGINE=rules

# Free tier, no credit card required: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Paid, $5 minimum credit purchase
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Local, free. Requires Ollama running: https://ollama.com
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
